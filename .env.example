# Copie para `.env` na raiz: cp .env.example .env
# Usado por `docker compose up --build` (não commite `.env`).

# Padrão do servidor; a UI sobrescreve. Configurações (modelos, Jev, disciplina de
# execução, prazos do LLM, teto de saída, plano ChatGPT) são escolhidas por usuário em
# /v1/settings. Precedência: usuário > este env > padrão do código. Segredos ficam só aqui.

# Obrigatório para chat (API sync + worker async via OpenRouter)
OPENROUTER_API_KEY=

# Opcional — modelo OpenRouter (padrão: openai/gpt-4o-mini)
# OPENROUTER_MODEL=openai/gpt-4o-mini
# F4 — fallback nativo do OpenRouter: tenta o modelo e depois cada um destes
# OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini,openai/gpt-4o

# --- Valores abaixo são os padrões do docker-compose (hostnames internos) ---
# Para desenvolvimento no host com pnpm, use 127.0.0.1 em apps/*/.env

# Postgres (serviço `postgres` na rede compose)
# Fase 0: senha configurável; o padrão "atlas" mantém volumes existentes.
# Em instalação nova, troque por valor forte antes do 1º `up`.
# Gerar: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://atlas:atlas@postgres:5432/atlas

# Redis (serviço `redis`, rede interna, sem porta publicada)
# Opcional: com REDIS_PASSWORD setada o servidor exige auth; nesse caso
# sobrescreva REDIS_URL com redis://:SUASENHA@redis:6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# Obrigatorio no compose (NODE_ENV=production). Use um valor aleatorio persistente;
# trocar o valor invalida os secrets de webhooks de rotinas existentes.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ATLAS_HOOK_PEPPER=

# --- Auth (conta única, Better Auth) ---
# URL base pública (única variável de domínio — o resto deriva dela).
# Local: http://localhost:3000 · VPS: https://atlas.seudominio.com
ATLAS_URL=http://localhost:3000
# Único e-mail autorizado (cadastro fechado; outros são recusados no callback).
ATLAS_OWNER_EMAIL=
# Segredo das sessões (gerar como o pepper acima, valor distinto).
BETTER_AUTH_SECRET=
# E-mail do magic link: vazio/log:// imprime no log (padrão dev);
# smtp(s)://usuario:senha@host:porta ou resend://API_KEY. Ver AUTH_PLAN.md §3.3.
MAIL_URL=log://
MAIL_FROM=Atlas <no-reply@localhost>

# O browser usa /v1 e /api/auth na origem do web; o Next encaminha para a API interna.

# Computer-use: URLs do noVNC no browser do host (portas dinâmicas por sessão)
SANDBOX_VIEWER_HOST=http://localhost

# direct (padrão): o browser abre ${SANDBOX_VIEWER_HOST}:porta (VM no mesmo PC).
# proxy: a API faz proxy autenticado do noVNC em
# /v1/sandbox/sessions/:id/viewer/ — obrigatório em servidor remoto, onde as
# portas da VM só existem em 127.0.0.1 do host. Exige que o Traefik envie
# /v1/sandbox direto ao serviço api (WebSocket; ver docker-compose.yml).
# SANDBOX_VIEWER_MODE=direct

# Host usado pela API para falar com o control server da sandbox.
# Em docker compose a API roda em container → host.docker.internal.
# Rodando a API no host (pnpm dev), use 127.0.0.1.
SANDBOX_CONTROL_HOST=host.docker.internal

# CORS do app web (origens permitidas na API)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Sandbox Docker (API monta o socket do host — ver README)
# SANDBOX_ENABLED=true
# Imagens das sandboxes. Padrão no código: atlas-*:latest (build local). O docker-compose.yml de produção
# usa as do GHCR (ghcr.io/ali-ali18/atlas-agent-sandbox, atlas-code-runner, atlas-dev-sandbox);
# para fixar outra, defina SANDBOX_IMAGE / CODE_RUNNER_IMAGE / DEV_SANDBOX_IMAGE (e ATLAS_SANDBOX_TAG para a tag).
# SANDBOX_IMAGE=atlas-agent-sandbox:latest
# run_code (Python leve, container efêmero): docker build -t atlas-code-runner:latest docker/code-runner
# CODE_RUNNER_ENABLED=true
# CODE_RUNNER_IMAGE=atlas-code-runner:latest
# DEV_SANDBOX_IMAGE=atlas-dev-sandbox:latest
# DOCKER_SOCKET_PATH=/var/run/docker.sock

# TLS self-signed no noVNC do sandbox (dev). Com true, use
# SANDBOX_VIEWER_HOST=https://... (o browser vai avisar do cert self-signed).
# Em prod, prefira terminar TLS num reverse proxy/app.
# SANDBOX_TLS=false

# Recursos do container de sessão (XFCE + Chromium pedem ~2GiB).
# SANDBOX_MEMORY_MB=2048
# SANDBOX_CPUS=1

# A VM guarda o login do navegador, então NÃO é parada por inatividade por padrão.
# Ela para quando o usuário clica em "Desligar computador", quando o bot termina
# (sandbox_release) ou pelo guarda de memória abaixo (para a VM ociosa há mais tempo
# e avisa o dono por push).
# SANDBOX_MAX_RUNNING=3        # máx. de VMs ligadas ao mesmo tempo (0 = sem limite)
# SANDBOX_MIN_FREE_MEM_MB=512  # memória disponível mínima do servidor (0 = não checa)
# Modo antigo: SANDBOX_IDLE_STOP=1 volta a parar VM ociosa após SANDBOX_TTL_MS.
# SANDBOX_IDLE_STOP=0
# SANDBOX_TTL_MS=900000

# --- Pesquisa web (Parte B: web_search / web_extract, provedor plugável) ---
# SEARCH_PROVIDER=firecrawl  # firecrawl | tavily | brave | serper (padrão: firecrawl)
# SEARCH_API_KEY=            # chave do provedor de busca (precedência sobre FIRECRAWL_API_KEY)
# FIRECRAWL_API_KEY=         # busca (quando provider=firecrawl) + fallback de extração
# Sem chave, as tools usam o pipeline próprio (SearXNG + Readability) e o
# fallback é o navegador (navigate + browser_text).
# --- Atlas Search S1/S2 (busca própria, sem providers pagos) ---
# URL do SearXNG. No compose já vale `http://searxng:8080` (rede interna,
# sem ports publicadas). Rodando no host (pnpm dev), vazio = DuckDuckGo
# direto como fallback.
# SEARXNG_BASE_URL=http://searxng:8080
# Parte C (sheets via API, service account; sem env as tools somem e cai na GUI):
# GOOGLE_SHEETS_CLIENT_EMAIL=
# GOOGLE_SHEETS_PRIVATE_KEY=

# --- Conectores MCP (Marketplace) ---
# Cofre dos tokens/chaves: 32 bytes em base64 (mesmo valor na API e no worker).
# Também deriva o secret do webhook do GitHub (ver seção abaixo) — sem env
# var própria pra isso.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CONNECTOR_ENCRYPTION_KEY=
# Login OAuth (etapa 5). O callback usa a mesma ATLAS_URL de cima — tem que
# bater EXATAMENTE com o cadastrado no app OAuth (localhost ≠ 127.0.0.1).
# callback OAuth dos conectores = ${ATLAS_URL}/v1/mcp/oauth/callback
# Notion e MCP personalizado com OAuth: nada a configurar (registro automático).
# GitHub: crie um OAuth App em https://github.com/settings/applications/new
# (callback = URL acima). Sem isso, o GitHub conecta por token pessoal (PAT).
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# --- Gatilho GitHub de rotinas (webhook único, sem polling; ver apps/api e
# apps/worker) ---
# URL pública da API — o GitHub entrega o webhook em
# ${ATLAS_PUBLIC_URL}/v1/hooks/github. Opcional: sem ela vale o ATLAS_URL
# (o web repassa /v1/* à API). Se a URL resultante for localhost/127.0.0.1,
# o gatilho GitHub recusa criar/editar rotina.
# ATLAS_PUBLIC_URL=https://sua-api-publica.exemplo.com
# Secret compartilhado (todo o install, não por rotina/repo): assina o
# webhook criado no repo e valida `X-Hub-Signature-256` na entrega. Não tem
# env var própria — é derivado (HMAC-SHA256, unidirecional) da
# CONNECTOR_ENCRYPTION_KEY acima. Configure CONNECTOR_ENCRYPTION_KEY pra
# habilitar o gatilho GitHub.

# --- GitHub App (instalação por usuário; ver README "GitHub App") ---
# Normalmente NÃO configure nada aqui: o dono clica em "Criar GitHub App" em
# Configurações > Conexões e as credenciais ficam cifradas no banco. Estas
# variáveis são override para ops e, quando definidas, valem sobre o banco.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_WEBHOOK_SECRET=
# PEM da chave privada (aceita \n literal ou o PEM inteiro em base64).
# GITHUB_APP_PRIVATE_KEY=
# Necessários só para provar quem instalou (OAuth do app):
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# Slack: crie um app em https://api.slack.com/apps (redirect = URL acima).
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# Google (Gmail, Drive, Agenda, Planilhas): app OAuth tipo "Aplicativo da Web" em
# https://console.cloud.google.com/apis/credentials (redirect = URL acima). Ative as
# APIs normais + as "... MCP API" e adicione seu e-mail em Público-alvo → Usuários de teste.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=


# F3: manutenção independente do modelo da tarefa; vazio usa SUMMARIZER_MODEL.
# ATLAS_MAINTENANCE_MODEL=
# Prazo total por decisão, primeiro evento útil e inatividade (ms, inteiros positivos).
# LLM_DECISION_TIMEOUT_MS=90000
# LLM_FIRST_EVENT_TIMEOUT_MS=30000
# LLM_IDLE_TIMEOUT_MS=20000
# Orçamento explícito do loop. Leitura usa 4096 por padrão; create_file usa teto nativo.
# Manutenção não herda este teto. Reasoning é reduzido para caber na saída disponível.
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_REASONING_MAX_TOKENS=
# Custo máximo por execução em USD (padrão: 0.25). Válidos: 0.05, 0.10, 0.25, 0.50, 1.00.
# ATLAS_MAX_RUN_COST_USD=0.25
# F3b: disciplina de execução (ledger, resultado idêntico vira referência, aviso de estagnação,
# corte com paginação, colapso de histórico em lote). on (padrão) ou off para o comportamento anterior.
# ATLAS_EXECUTION_DISCIPLINE=on
# F6: economia de contexto (tools nativas raras adiadas e carregadas por intenção ou busca, prompt por
# procedimento). on (padrão) ou off para enviar todas as tools e o prompt inteiro como antes.
# ATLAS_CONTEXT_ECONOMY=on
# F6: resultado de tool acima de N caracteres é guardado como artefato do dono e ganha uma linha de
# referência (REF); acima de STUB só o começo fica no contexto. Releitura via artifact_read.
# ATLAS_CONTEXT_REF_CHARS=6000
# ATLAS_CONTEXT_STUB_CHARS=20000
# F6: orçamento operacional de contexto em tokens (independe da janela do modelo): passou do teto,
# compacta até o alvo preservando objetivo, entregas e referências. Vale com a economia ligada.
# ATLAS_CONTEXT_BUDGET_TARGET_TOKENS=12000
# ATLAS_CONTEXT_BUDGET_MAX_TOKENS=20000
# Memoria da conversa "Padrao" (resume a parte antiga perto do limite do modelo): gatilho em 80% da janela, com teto absoluto.
# CONTEXT_STANDARD_MAX_TOKENS=160000
# CONTEXT_STANDARD_WINDOW_FRACTION=0.8

# SIWC oficial: apenas projeto pessoal local e dono ATLAS_OWNER_EMAIL.
ATLAS_PROVIDER_CHATGPT_ENABLED=false
# Callback no navegador da mesma máquina; cofre usa CONNECTOR_ENCRYPTION_KEY.
ATLAS_SIWC_CALLBACK_PORT=53682
# API local: 127.0.0.1. Docker: 0.0.0.0 DENTRO do container, publique apenas
# 127.0.0.1:53682:53682 no host (nunca 0.0.0.0 no host).
# ATLAS_SIWC_CALLBACK_BIND=127.0.0.1

# Janela conservadora se o catálogo ChatGPT não informar contexto.
ATLAS_CHATGPT_CONTEXT_TOKENS=64000
# Hipótese: janela de reset não documentada; cooldown evita gastar decisões a cada 429.
ATLAS_CHATGPT_LIMIT_COOLDOWN_MS=900000

# --- Notificações push (Web Push / PWA) ---
# Gere o par com `pnpm --filter @workspace/mail push:vapid` (ou node packages/mail/scripts/generate-vapid-keys.mjs).
# Sem as três variáveis o app funciona, mas não envia avisos no celular. API e worker usam as mesmas chaves.
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:voce@exemplo.com.br

# --- Marketplace de skills e agentes ---
# Base do catálogo (precisa servir index.json e as pastas skills/ e bots/ por https; hosts privados são
# bloqueados pelo guard SSRF). Vazio = https://raw.githubusercontent.com/ali-ali18/agent-skills/main
# SKILLS_CATALOG_URL=

# --- Observabilidade / diagnóstico ---
# Sentry: sem SENTRY_DSN nada é enviado (api, worker e web seguem normais). Segredos (Authorization,
# cookies, chaves, ?secret=) e dados pessoais são removidos antes do envio.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# O commit (release do Sentry e Diagnóstico) é descoberto sozinho no build, lendo o .git; sem .git só a versão aparece.
# Testes do db com Postgres+pgvector efêmero: `pnpm test:db` (sobe um container). Para usar um banco já
# existente: ATLAS_TEST_DB_URL=postgresql://user:pass@host:5432/atlas_test (o nome precisa conter "test").

# --- Deploy por imagem (Dokploy; ver docs/deploy-dokploy.md) ---
# Tag de web/api/worker/migrate no GHCR. `latest` acompanha a main; para rollback use `sha-abc1234`.
# ATLAS_IMAGE_TAG=latest
# Tag das sandboxes (só são reconstruídas quando docker/<nome> muda; normalmente fica `latest`).
# ATLAS_SANDBOX_TAG=latest
