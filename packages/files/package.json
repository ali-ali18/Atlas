{
  "name": "@workspace/files",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "node -e \"process.exit(0)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@workspace/sandbox": "workspace:*",
    "@workspace/shared": "workspace:*",
    "docx": "^9.8.1",
    "exceljs": "^4.4.0",
    "jszip": "3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/sanitize-html": "^2.16.2",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
