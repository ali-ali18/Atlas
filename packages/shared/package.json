{
  "name": "@workspace/shared",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "node -e \"process.exit(0)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./avatar/*": {
      "types": "./src/avatar/*.ts",
      "import": "./dist/avatar/*.js",
      "default": "./dist/avatar/*.js"
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "tldts": "^7.4.19",
    "zod": "^4.4.3"
  }
}
