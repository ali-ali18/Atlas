{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "version": "../package.json",
  "identifier": "com.atlasagent.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm run build:frontend",
    "beforeBuildCommand": "pnpm run build:frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src https: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Atlas",
    "shortDescription": "Atlas no seu computador",
    "longDescription": "App desktop do Atlas: abre o Atlas web numa janela própria, com bandeja e atalho global.",
    "category": "Productivity",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Atlas"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "SUBSTITUA_PELA_CHAVE_PUBLICA (ver apps/desktop/README.md, seção Atualizações)",
      "endpoints": [
        "https://github.com/ali-ali18/Atlas/releases/download/desktop-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
