{
  "name": "atlas",
  "version": "0.3.0-beta",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "pnpm -r --if-present --workspace-concurrency=1 --filter \"!@workspace/db\" test && pnpm --filter @workspace/db test",
    "test:all": "pnpm -r --if-present --workspace-concurrency=1 --filter \"!@workspace/db\" test",
    "test:db": "pnpm --filter @workspace/db test:db",
    "e2e": "pnpm --filter web e2e",
    "test:scripts": "node --test scripts/changelog.test.mjs scripts/resolve-git-commit.test.mjs"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "vite@>=7.0.0 <7.3.7": "7.3.7",
      "image-size@>=1.2.0 <2.0.3": "2.0.4",
      "uuid@<11.1.1": "11.1.1",
      "fast-uri@>=3.0.0 <3.1.8": "3.1.8",
      "ip-address@<10.7.1": "10.7.4",
      "proxy-addr@<2.0.8": "2.0.8",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "nanoid@<3.3.18": "3.3.20",
      "postcss@<8.5.23": "8.5.31",
      "source-map-js@<1.2.2": "1.2.2",
      "browserslist@<4.28.7": "4.29.4",
      "deepmerge-ts@<8.0.0": "8.0.2",
      "@grpc/grpc-js@<1.14.5": "1.14.6",
      "baseline-browser-mapping@<2.11.0": "2.11.30"
    }
  }
}
